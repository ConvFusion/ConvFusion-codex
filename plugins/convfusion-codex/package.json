{
  "name": "convfusion-codex",
  "version": "0.2.0-codex.1",
  "description": "ConvFusion research operating system as a Codex plugin with a native skill and bundled local MCP adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConvFusion/ConvFusion-codex.git"
  },
  "homepage": "https://github.com/ConvFusion/ConvFusion-codex",
  "bugs": {
    "url": "https://github.com/ConvFusion/ConvFusion-codex/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "assets",
    "lib",
    "skills",
    "scripts/convfusion-mcp.mjs"
  ],
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "version:set": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "verify:codex": "npm run version:check && node scripts/verify-codex-plugin.mjs",
    "clean": "rm -rf lib"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
